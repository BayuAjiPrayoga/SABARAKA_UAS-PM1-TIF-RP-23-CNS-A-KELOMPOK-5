<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logo atau gambar utama -->

    <!-- Judul utama -->
    <ImageView
        android:layout_width="345dp"
        android:layout_height="284dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="3dp"
        android:contentDescription="SABARAKA Logo"
        android:src="@drawable/welcome" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="SABARAKA"
        android:textColor="#0047FF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Subjudul -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="Sistem Administrasi Barang Kampus"
        android:textColor="#0047FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Deskripsi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:text="Silih asah, silih asih, silih asuh....di sakola urang\n\nKelola dan pinjam barang dengan mudah dan efisien"
        android:textColor="#666666"
        android:textSize="14sp"
        android:lineSpacingMultiplier="0.5" />

    <!-- Spacer untuk mendorong tombol ke bawah -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tombol Login -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#0047FF"
        android:text="MASUK"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />

    <!-- Tombol Register -->
    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_outline_blue"
        android:text="DAFTAR"
        android:textColor="#0047FF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Tombol Admin (tersembunyi atau untuk testing) -->
<!--    <TextView-->
<!--        android:id="@+id/tvAdminLogin"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_gravity="center_horizontal"-->
<!--        android:layout_marginTop="16dp"-->
<!--        android:text="Login sebagai Admin"-->
<!--        android:textColor="#999999"-->
<!--        android:textSize="12sp"-->
<!--        android:visibility="visible" />-->

</LinearLayout>
