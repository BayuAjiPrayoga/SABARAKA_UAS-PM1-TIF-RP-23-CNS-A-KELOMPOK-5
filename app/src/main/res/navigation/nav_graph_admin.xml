<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_admin"
    app:startDestination="@id/adminItemListFragment">

    <fragment
        android:id="@+id/adminItemListFragment"
        android:name="com.kelompok5.sabaraka.ui.admin.AdminItemListFragment"
        android:label="Kelola Barang"
        tools:layout="@layout/fragment_admin_item_list" >
        <action
            android:id="@+id/action_adminItemListFragment_to_addItemFragment"
            app:destination="@id/addItemFragment" />
        <action
            android:id="@+id/action_adminItemListFragment_to_editItemFragment"
            app:destination="@id/editItemFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminBorrowRequestFragment"
        android:name="com.kelompok5.sabaraka.ui.admin.AdminBorrowRequestFragment"
        android:label="Kelola Peminjaman"
        tools:layout="@layout/fragment_admin_borrow_request" />

    <fragment
        android:id="@+id/addItemFragment"
        android:name="com.kelompok5.sabaraka.ui.admin.AddItemFragment"
        android:label="Tambah Barang"
        tools:layout="@layout/fragment_add_item" />

    <fragment
        android:id="@+id/editItemFragment"
        android:name="com.kelompok5.sabaraka.ui.admin.EditItemFragment"
        android:label="Edit Barang"
        tools:layout="@layout/fragment_edit_item" />

</navigation>
